<!DOCTYPE html>
<html>
<head><title>订单列表</title></head>
<body>
  <a href="/courses">返回课程</a>
  <h2>订单列表（示例查询所有）</h2>
  <table border="1" cellpadding="6">
    <tr><th>订单号</th><th>课程</th><th>金额</th><th>状态</th><th>来源小节</th></tr>
    <% orders.forEach(o => { %>
      <tr>
        <td><%= o.order_no %></td>
        <td><%= o.course_title %></td>
        <td>¥<%= o.total_price %></td>
        <td><%= o.status %></td>
        <td><%= o.source_lesson_id || '-' %></td>
      </tr>
    <% }) %>
  </table>
</body>
</html>
