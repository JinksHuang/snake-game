page {
  background: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}
.card {
  background: #fff;
  padding: 16rpx;
  margin: 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.button-primary {
  background-color: #07c160;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}
.locked {
  color: #999;
}
