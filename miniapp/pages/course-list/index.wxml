<view class="banner card">
  <text class="banner-title">私域操盘课</text>
  <text class="banner-sub">主推课程，助力商家跑通私域增长</text>
</view>
<view>
  <block wx:for="{{courses}}" wx:key="id">
    <view class="card" bindtap="goDetail" data-id="{{item.id}}">
      <image src="{{item.cover_url}}" mode="aspectFill" style="width:100%;height:200rpx;border-radius:8rpx;" />
      <view style="margin-top:12rpx;">
        <view style="font-size:32rpx;font-weight:bold;">{{item.title}}</view>
        <view style="color:#666;margin-top:4rpx;">{{item.subtitle}}</view>
        <view style="margin-top:8rpx;display:flex;align-items:center;justify-content:space-between;">
          <view>
            <text style="color:#f54;font-weight:bold;">¥{{item.promo_price || item.price}}</text>
            <text wx:if="{{item.promo_price}}" style="text-decoration:line-through;color:#aaa;margin-left:8rpx;">¥{{item.price}}</text>
          </view>
          <view wx:if="{{item.purchased}}" style="color:#07c160;">已购买</view>
        </view>
      </view>
    </view>
  </block>
</view>
